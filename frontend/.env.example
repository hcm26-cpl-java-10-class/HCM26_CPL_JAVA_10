# Copy file này thành .env rồi chỉnh lại cho môi trường của bạn.

# Base URL của backend (Spring Boot)
VITE_API_URL=http://localhost:8080/api

# Base URL của frontend (Vite dev server) - dùng để sinh link share cho sinh viên
# KHÔNG được trỏ về backend, nếu không link sẽ mở ra trang trắng.
VITE_FRONTEND_URL=http://localhost:5173
