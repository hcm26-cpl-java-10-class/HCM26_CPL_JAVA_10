          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/v1/classes/{classId}/allocation-sessions/{sessionId}/teams/{teamId}/roles": {
      "put": {
        "tags": ["5.2.6 Team Role Quotas"],
        "summary": "Lưu và kiểm tra vai trò thành viên của nhóm",
        "operationId": "updateTeamRoles",
        "parameters": [
          { "name": "classId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "example": 1 } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "example": 10 } },
          { "name": "teamId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "example": 5 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TeamRolesRequest" },
              "example": {
                "expectedVersion": 2,
                "members": [
                  { "memberId": 11, "roles": ["PM"] },
                  { "memberId": 12, "roles": ["BA"] },
                  { "memberId": 13, "roles": ["DEV"] },
                  { "memberId": 14, "roles": ["QA"] }
                ]
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Lưu vai trò thành công" },
          "400": {
            "description": "Phiên hoặc nhóm không cho phép cập nhật vai trò",
            "content": {
              "application/json": {
                "example": { "status": 400, "errorCode": "ERR_INVALID_BATCH_DATA", "message": "Chỉ có thể cập nhật vai trò cho nhóm DRAFT hoặc ACTIVE" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": {
            "description": "Vai trò hoặc định suất không hợp lệ",
            "content": {
              "application/json": {
                "example": {
                  "status": 422,
                  "errorCode": "ERR_TEAM_ROLE_QUOTA_NOT_MET",
                  "message": "Cấu hình vai trò chưa đáp ứng định suất của đề bài. Còn thiếu vai trò bắt buộc: QA (cần tối thiểu 1, hiện có 0)",
                  "invalidMemberIds": [],
                  "violations": [
                    { "role": "QA", "reason": "MISSING_REQUIRED_ROLE", "required": 1, "actual": 0 }
                  ],
                  "multiRoleMemberIds": [],
                  "timestamp": "2026-11-10T09:40:00"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

