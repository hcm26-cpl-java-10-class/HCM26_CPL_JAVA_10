    "/api/project-template-versions/{id}/configuration/team-constraints": {
      "put": {
        "tags": ["5.2.6 Team Role Quotas"],
        "summary": "Cấu hình định suất vai trò của phiên bản template",
        "operationId": "saveTeamConstraints",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID phiên bản template",
            "schema": { "type": "integer", "format": "int64", "example": 3 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TeamConstraintsRequest" },
              "example": {
                "minMembers": 4,
                "maxMembers": 6,
                "roleQuotas": { "pm": 1, "ba": 1, "dev": 2, "qa": 1 },
                "allowMultiRole": false,
                "lockVersion": 3
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cấu hình định suất sau khi lưu",
            "content": {
              "application/json": {
                "example": {
                  "version": { "id": 3, "version": "v2.0", "status": "DRAFT" },
                  "template": {
                    "id": 1,
                    "name": "Capstone Template",
                    "status": "DRAFT",
                    "lockVersion": 4,
                    "teamConstraints": {
                      "minMembers": 4,
                      "maxMembers": 6,
                      "roleQuotas": { "pm": 1, "ba": 1, "dev": 2, "qa": 1 },
                      "allowMultiRole": false
                    }
                  },
                  "editable": true,
                  "canPublish": true,
                  "legacyContent": false
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
