  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Dán access token lấy từ API đăng nhập."
      }
    },
    "schemas": {
      "SprintRequest": {
        "type": "object",
        "required": ["name", "sprintGoal", "startDate", "endDate", "isActive"],
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Sprint 4 - Release" },
          "sprintGoal": { "type": "string", "minLength": 1, "maxLength": 500, "example": "Hoàn thiện luồng tạo Sprint và Sprint Goal trước buổi demo" },
          "startDate": { "type": "string", "format": "date-time", "example": "2026-11-12T08:00:00" },
          "endDate": { "type": "string", "format": "date-time", "example": "2026-11-26T17:00:00" },
          "status": { "type": "string", "enum": ["PLANNED", "ACTIVE", "COMPLETED", "CANCELLED"], "example": "PLANNED" },
          "isActive": { "type": "boolean", "example": true },
          "teamId": { "type": "integer", "format": "int64", "example": 1 },
          "projectId": { "type": "integer", "format": "int64", "example": 1 }
        }
      },
      "SprintBacklogRequest": {
        "type": "object",
        "required": ["title", "isActive"],
        "properties": {
          "sprintId": { "type": "integer", "format": "int64", "nullable": true, "example": 1 },
          "projectId": { "type": "integer", "format": "int64", "nullable": true, "example": 1 },
          "milestoneId": { "type": "string", "format": "uuid", "nullable": true, "example": "11111111-1111-4111-8111-111111111111" },
          "title": { "type": "string", "maxLength": 200, "example": "Viết tài liệu kiến trúc hệ thống" },
          "description": { "type": "string", "maxLength": 1000, "example": "Mô tả kiến trúc 3 lớp, sơ đồ triển khai và các quyết định kỹ thuật chính." },
          "workType": { "type": "string", "enum": ["STORY", "BUG", "TASK"], "example": "TASK" },
          "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "REVIEW", "DONE"], "example": "TODO" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"], "example": "MEDIUM" },
          "assigneeProjectMemberId": { "type": "integer", "format": "int64", "nullable": true, "example": 1 },
          "reporterProjectMemberId": { "type": "integer", "format": "int64", "nullable": true, "example": 2 },
          "estimatedHours": { "type": "number", "format": "double", "minimum": 0, "example": 8.0 },
          "startDate": { "type": "string", "format": "date-time", "example": "2026-11-12T00:00:00" },
          "endDate": { "type": "string", "format": "date-time", "example": "2026-11-12T23:59:00" },
          "isActive": { "type": "boolean", "example": true }
        }
      },
      "SprintBacklogUpdateRequest": {
        "type": "object",
        "properties": {
          "sprintId": { "type": "integer", "format": "int64", "nullable": true, "example": 1 },
          "milestoneId": { "type": "string", "format": "uuid", "nullable": true, "example": "22222222-2222-4222-8222-222222222222" },
          "clearMilestone": { "type": "boolean", "example": false },
          "assigneeProjectMemberId": { "type": "integer", "format": "int64", "nullable": true, "example": 1 },
          "clearAssignee": { "type": "boolean", "example": false },
          "title": { "type": "string", "maxLength": 200, "example": "Viết tài liệu kiến trúc hệ thống" },
          "description": { "type": "string", "maxLength": 1000, "example": "Cập nhật mô tả kiến trúc." },
          "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "REVIEW", "DONE"], "example": "IN_PROGRESS" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"], "example": "HIGH" },
          "estimatedHours": { "type": "number", "format": "double", "minimum": 0, "example": 10.0 }
        }
      },
      "SprintBacklogPlan": {
        "type": "object",
        "required": ["taskIds"],
        "properties": {
          "taskIds": {
            "type": "array",
            "items": { "type": "integer", "format": "int64" },
            "example": [2, 1, 3]
          }
        }
      },
      "DuplicateTemplateRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Capstone Project Template (Copy)" }
        }
      },
      "TeamConstraintsRequest": {
        "type": "object",
        "required": ["minMembers", "maxMembers", "roleQuotas", "allowMultiRole", "lockVersion"],
        "properties": {
          "minMembers": { "type": "integer", "minimum": 1, "example": 4 },
          "maxMembers": { "type": "integer", "minimum": 1, "example": 6 },
          "roleQuotas": {
            "type": "object",
            "required": ["pm", "ba", "dev", "qa"],
            "properties": {
              "pm": { "type": "integer", "minimum": 0, "example": 1 },
              "ba": { "type": "integer", "minimum": 0, "example": 1 },
              "dev": { "type": "integer", "minimum": 0, "example": 2 },
              "qa": { "type": "integer", "minimum": 0, "example": 1 }
            }
          },
          "allowMultiRole": { "type": "boolean", "example": false },
          "lockVersion": { "type": "integer", "format": "int64", "minimum": 0, "example": 3 }
        }
      },
      "TeamRolesRequest": {
        "type": "object",
        "required": ["expectedVersion", "members"],
        "properties": {
          "expectedVersion": { "type": "integer", "format": "int64", "example": 2 },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["memberId", "roles"],
              "properties": {
                "memberId": { "type": "integer", "format": "int64", "example": 11 },
                "roles": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["PM", "BA", "DEV", "QA"] },
                  "example": ["PM"]
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Chưa đăng nhập hoặc token hết hạn",
        "content": {
          "application/json": {
            "example": { "status": 401, "message": "Unauthorized" }
          }
        }
      },
      "Forbidden": {
        "description": "Thiếu quyền hoặc ngoài phạm vi dữ liệu",
        "content": {
          "application/json": {
            "example": { "status": 403, "message": "Access is denied" }
          }
        }
      },
      "NotFound": {
        "description": "Không tìm thấy đối tượng",
        "content": {
          "application/json": {
            "example": { "status": 404, "message": "Resource not found" }
          }
        }
      },
      "Conflict": {
        "description": "Trùng dữ liệu hoặc dữ liệu đã bị thay đổi",
        "content": {
          "application/json": {
            "example": { "status": 409, "message": "Dữ liệu đã bị thay đổi, vui lòng tải lại trang" }
          }
        }
      },
      "ValidationError": {
        "description": "Dữ liệu không hợp lệ",
        "content": {
          "application/json": {
            "example": {
              "message": "Dữ liệu không hợp lệ",
              "errors": { "title": ["Vui lòng nhập tên Backlog item"] }
            }
          }
        }
      },
      "ServerError": {
        "description": "Lỗi hệ thống",
        "content": {
          "application/json": {
            "example": { "status": 500, "message": "Internal Server Error" }
          }
        }
      }
    }
  }
}
