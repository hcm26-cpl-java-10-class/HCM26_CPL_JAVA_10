{
  "docs-structure-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/check-docs-rule.mjs --hook-antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
