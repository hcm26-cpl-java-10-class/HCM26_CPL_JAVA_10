DB_URL=jdbc:mysql://localhost:3306/learnmangement?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8
DB_PASSWORD=root
MAIL_APP_PASSWORD=
JWT_SECRET=NeuNhuLopTreQuenDiLichSuCuaChinhDanTocMinhThiHoSePhaiDungMauCuaMinhDeVietLaiLichSuAy
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
APP_FRONTEND_DOMAIN=http://localhost:5173
APP_BACKEND_DOMAIN=http://localhost:8080

# GitHub App (Git Integration). Keep the .pem file OUTSIDE the repository.
GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/outside/repo/github-app.private-key.pem
# Same value as "Webhook secret" in the GitHub App settings. Webhook URL: <public URL>/api/webhooks/github
# (locally, expose http://localhost:8080 with smee.io or ngrok). Empty = webhooks rejected with 503.
GITHUB_APP_WEBHOOK_SECRET=
# Days the raw webhook payload is kept after processing (the event row is kept).
GITHUB_WEBHOOK_PAYLOAD_RETENTION_DAYS=15
# SY-04: retries of a failed webhook event (1m, 5m, 15m, 1h, 6h) before it becomes FAILED.
GITHUB_WEBHOOK_MAX_RETRIES=5
# SY-04: the GitHub App needs read access to Contents and Pull requests (same permissions the
# push / pull_request / pull_request_review webhook subscriptions already require).
GITHUB_APP_CALLBACK_URL=http://localhost:5173/git-integration/github/callback

# Optional: enables Gemini-powered Location insights and other AI features.
# Create backend/.env and set a real key; never commit secrets.
AI_ENABLED=true
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
