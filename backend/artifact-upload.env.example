# Upload is closed until the team's MIME, size, private-storage and scanner policy is set.
ARTIFACT_UPLOAD_ENABLED=false
ARTIFACT_UPLOAD_MAX_BYTES=0
# Supported detected MIME values: application/pdf, application/zip, image/png, image/jpeg, text/plain.
ARTIFACT_UPLOAD_ALLOWED_MIME_TYPES=
ARTIFACT_UPLOAD_STORAGE_PATH=./data/artifact-uploads

# Set to an internal, trusted ClamAV daemon. Do not expose clamd TCP publicly.
ARTIFACT_CLAMAV_HOST=
ARTIFACT_CLAMAV_PORT=3310
ARTIFACT_CLAMAV_TIMEOUT_MILLIS=5000

# Keep the servlet request limits at or above ARTIFACT_UPLOAD_MAX_BYTES.
ARTIFACT_UPLOAD_MAX_FILE_SIZE=10MB
ARTIFACT_UPLOAD_MAX_REQUEST_SIZE=11MB
