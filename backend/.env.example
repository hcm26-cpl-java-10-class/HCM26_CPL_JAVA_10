# Google Gemini API Key for AI Essay Grading & Similarity Detection
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Copy this file to ".env" (same folder as pom.xml) and paste your own key.
# The ".env" file is git-ignored, so each teammate keeps their own key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Git Activity demo: seed the same sample scenarios in each active Workspace.
# Defaults to true; no GitHub credentials or copied H2 database are needed.
# Existing real repositories and existing sample edits are preserved.
GIT_ACTIVITY_DEMO_ENABLED=true
