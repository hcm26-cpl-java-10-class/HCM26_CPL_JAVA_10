                  "       pm.collectionVariables.set(ac + \"_teamId\", String(row.teamId));",
                  "       pm.collectionVariables.set(ac + \"_projectId\", String(row.projectId));",
                  "       pm.collectionVariables.unset(ac + \"_run\");",
                  "       pm.collectionVariables.unset(ac + \"_workspaceId\");",
                  "       pm.collectionVariables.unset(ac + \"_firstResponse\");",
