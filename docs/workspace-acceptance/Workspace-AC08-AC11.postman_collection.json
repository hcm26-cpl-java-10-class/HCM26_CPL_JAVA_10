                  "     const row = rows.find(r => r.teamCode === prefix + \"-\" + ac.toUpperCase());",
                  "     pm.test(ac + \" fixture exists\", () => pm.expect(row, \"Check fixturePrefix and SQL connection\").to.be.an(\"object\"));",
