              "});",
              "",
              "function inspect(value) {",
              "  if (!value || typeof value !== \"object\") return;",
              "  for (const [key, item] of Object.entries(value)) {",
              "    pm.expect([\"password\",\"passwordHash\",\"password_hash\",\"token\",\"accessToken\",\"refreshToken\",\"email\",\"phone\",\"draftScores\",\"unreleasedFeedback\"]).not.to.include(key);",
              "    inspect(item);",
              "  }",
              "}",
              "pm.test(\"No restricted fields\", () => inspect(pm.response.json()));"
            ]
          }
