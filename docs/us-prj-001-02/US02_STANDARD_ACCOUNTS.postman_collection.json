            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login returns 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
              "  pm.collectionVariables.set(\"teacherToken\", data.accessToken.trim());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Login student",
