      ]
    },
    {
      "name": "07 - Management roster - teacher",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/project-hub/teams/{{teamId}}/members",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Assigned teacher may manage the roster\", () => pm.response.to.have.status(200));",
              "const row = pm.response.json().find(member => member.userCode && member.userCode.startsWith(\"SE\"));",
              "if(row) pm.collectionVariables.set(\"studentUserId\", row.userId);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Student cannot access management roster",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/project-hub/teams/{{teamId}}/members",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Student has no management permission\", () => pm.response.to.have.status(403));",
              "pm.test(\"No member list returned\", () => pm.expect(pm.response.json()).not.to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - AC09 Missing workspace - admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspaces/9223372036854775807",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
