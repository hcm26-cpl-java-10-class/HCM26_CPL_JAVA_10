      ]
    },
    {
      "name": "10 - AC09 Invalid session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid-token-for-ac09"
          }
        ],
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid token returns 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - AC02 Snapshot remains fixed - repeat after source update",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Overview returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"The stored snapshot remains unchanged\", () => {",
              " pm.expect(JSON.stringify(pm.response.json().topic_snapshot)).to.equal(pm.collectionVariables.get(\"fixedSnapshot\"));",
              "});"
            ]
          }
        }
      ]
    }
  ]
