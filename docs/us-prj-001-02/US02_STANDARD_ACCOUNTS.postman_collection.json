{
  "info": {
    "name": "US-PRJ-001-02 - Standard accounts acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use the existing admin/teacher/student accounts. Run the initial checks on Team Pixel before changing its roster or permissions. See MANUAL_TEST_AC01_AC10.md for the required UI steps, data setup and cleanup. No workspace is created by this collection."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "workspaceId",
      "value": ""
    },
    {
      "key": "teamId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "studentUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login returns 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
              "  pm.collectionVariables.set(\"adminToken\", data.accessToken.trim());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Login teacher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
