              "  pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
              "  pm.collectionVariables.set(\"studentToken\", data.accessToken.trim());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Discover Team Pixel IDs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspaces/candidates",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Candidates returns 200\", () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "const pixel = rows.find(row => row.teamCode === \"WS-DEMO-PIXEL\");",
              "pm.test(\"Pixel has an existing workspace\", () => {",
              "  pm.expect(pixel, \"Restart backend to prepare existing accounts and fixtures\").to.exist;",
              "  pm.expect(pixel.workspaceId).to.be.a(\"number\");",
              "});",
              "if(pixel) {",
              "  pm.collectionVariables.set(\"workspaceId\", pixel.workspaceId);",
              "  pm.collectionVariables.set(\"teamId\", pixel.teamId);",
              "  pm.collectionVariables.set(\"projectId\", pixel.projectId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - AC01 Overview - teacher",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Overview returns 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Correct workspace/project/team\", () => {",
              " pm.expect(String(data.id)).to.equal(String(pm.collectionVariables.get(\"workspaceId\")));",
              " pm.expect(String(data.teamId)).to.equal(String(pm.collectionVariables.get(\"teamId\")));",
              " pm.expect(String(data.projectId)).to.equal(String(pm.collectionVariables.get(\"projectId\")));",
              " pm.expect(data).not.to.have.property(\"members\");",
              "});",
              "pm.collectionVariables.set(\"activeMemberCount\", data.member_count);",
              "pm.collectionVariables.set(\"fixedSnapshot\", JSON.stringify(data.topic_snapshot));",
              "",
              "function inspect(value) {",
              "  if (!value || typeof value !== \"object\") return;",
              "  for (const [key, item] of Object.entries(value)) {",
              "    pm.expect([\"password\",\"passwordHash\",\"password_hash\",\"token\",\"accessToken\",\"refreshToken\",\"email\",\"phone\",\"draftScores\",\"unreleasedFeedback\"]).not.to.include(key);",
              "    inspect(item);",
              "  }",
              "}",
              "pm.test(\"No restricted fields\", () => inspect(pm.response.json()));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - AC03 AC04 Members - teacher",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Members returns 200\", () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test(\"Exactly four approved fields and active roster\", () => {",
              " pm.expect(rows).to.be.an(\"array\");",
              " for (const member of rows) {",
              "  pm.expect(Object.keys(member).sort()).to.eql([\"display_name\",\"project_role\",\"status\",\"user_code\"]);",
              "  pm.expect(member.status).to.equal(\"ACTIVE\");",
              "  pm.expect([\"UNASSIGNED\",\"TEAM_LEADER\",\"DEV\",\"FE_DEV\",\"BE_DEV\",\"BA\",\"QA\",\"TESTER\"]).to.include(member.project_role);",
              " }",
              " pm.expect(rows.length).to.equal(Number(pm.collectionVariables.get(\"activeMemberCount\")));",
              " const codes = rows.map(row => row.user_code).filter(Boolean);",
              " pm.expect(new Set(codes).size).to.equal(codes.length);",
              "});",
              "",
              "function inspect(value) {",
              "  if (!value || typeof value !== \"object\") return;",
              "  for (const [key, item] of Object.entries(value)) {",
              "    pm.expect([\"password\",\"passwordHash\",\"password_hash\",\"token\",\"accessToken\",\"refreshToken\",\"email\",\"phone\",\"draftScores\",\"unreleasedFeedback\"]).not.to.include(key);",
              "    inspect(item);",
              "  }",
              "}",
              "pm.test(\"No restricted fields\", () => inspect(pm.response.json()));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - AC08 Overview - student",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Student Overview returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Roster is not embedded\", () => pm.expect(pm.response.json()).not.to.have.property(\"members\"));",
              "",
              "function inspect(value) {",
              "  if (!value || typeof value !== \"object\") return;",
              "  for (const [key, item] of Object.entries(value)) {",
              "    pm.expect([\"password\",\"passwordHash\",\"password_hash\",\"token\",\"accessToken\",\"refreshToken\",\"email\",\"phone\",\"draftScores\",\"unreleasedFeedback\"]).not.to.include(key);",
              "    inspect(item);",
              "  }",
              "}",
              "pm.test(\"No restricted fields\", () => inspect(pm.response.json()));"
            ]
          }
        }
      ]
    },
